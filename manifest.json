{
  "manifest_version": 3,
  "name": "Video Tools",
  "version": "1.1.0",
  "description": "Save videos, audio and transcripts. Choose exactly where your clip begins and ends.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging",
    "contextMenus",
    "alarms"
  ],
  "background": {
    "service_worker": "extension/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Video Tools",
    "default_popup": "extension/popup.html",
    "default_icon": {
      "16": "extension/icons/16.png",
      "32": "extension/icons/32.png"
    }
  },
  "icons": {
    "16": "extension/icons/16.png",
    "32": "extension/icons/32.png",
    "48": "extension/icons/48.png",
    "128": "extension/icons/128.png"
  },
  "options_ui": {
    "page": "extension/popup.html?settings=1",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "key": ""
}
